<?xml version="1.0" ?>
<rvx>
	<platform>
		<name>eMamba_BRAM_WB</name>
		<status>described</status>
		<spec>
			<define><name>sram_size</name><value>256kB</value></define>
			<define><name>num_lock_user</name><value>1</value></define>
			<define><name>use_profiling</name><value type="bool">True</value></define>
			<define><name>include_timer</name><value type="bool">True</value></define>
			<define><name>include_fast_dram</name><value type="bool">True</value></define>
			<define><name>num_led_checker</name><value>1</value></define>
			<define><name>num_core_user</name><value>1</value></define>
			<!-- <define><name>include_edge_video_system</name><value type="bool">True</value></define> -->
			<define><name>include_florian</name><value type="bool">True</value></define>
		</spec>

		<ip_instance>
			<name>i_main_core</name>
			<library_name>rvc_orca</library_name>
		</ip_instance>

		<ip_instance>
			<name>eMamba_IP</name>
			<library_name>user_slaveif_axi4_clkout</library_name>
			<parameter><id>SIZE_OF_MEMORYMAP</id><value>0x800</value></parameter>
			<parameter><id>BW_ADDR</id><value>32</value></parameter>
			<parameter><id>BW_DATA</id><value>32</value></parameter>
			<parameter><id>BW_AXI_TID</id><value>1</value></parameter>
		</ip_instance>

		<ip_instance>
			<name>input_bram</name>
			<library_name>user_slaveif_axi_clkout</library_name>
			<parameter><id>SIZE_OF_MEMORYMAP</id><value>0x8000</value></parameter>
			<parameter><id>BW_ADDR</id><value>32</value></parameter>
			<parameter><id>BW_DATA</id><value>32</value></parameter>
			<parameter><id>BW_AXI_TID</id><value>1</value></parameter>
		</ip_instance>

		<ip_instance>
			<name>wb_bram</name>
			<library_name>user_slaveif_axi_clkout</library_name>
			<parameter><id>SIZE_OF_MEMORYMAP</id><value>0x8000</value></parameter>
			<parameter><id>BW_ADDR</id><value>32</value></parameter>
			<parameter><id>BW_DATA</id><value>32</value></parameter>
			<parameter><id>BW_AXI_TID</id><value>1</value></parameter>
		</ip_instance>

		<ip_instance>
			<name>output_bram</name>
			<library_name>user_slaveif_axi_clkout</library_name>
			<parameter><id>SIZE_OF_MEMORYMAP</id><value>0x2000</value></parameter>
			<parameter><id>BW_ADDR</id><value>32</value></parameter>
			<parameter><id>BW_DATA</id><value>32</value></parameter>
			<parameter><id>BW_AXI_TID</id><value>1</value></parameter>
		</ip_instance>

		<clock_info>
			<define>
				<name>clk_core</name>
				<value type="dec">100000000</value>
			</define>
		</clock_info>
	</platform>
</rvx>