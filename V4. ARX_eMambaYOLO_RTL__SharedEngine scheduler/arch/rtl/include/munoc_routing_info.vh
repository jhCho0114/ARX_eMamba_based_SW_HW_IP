case(NETWORK_TYPE)
	`FORWARD_NETWORK:
		case(ROUTER_ID)
			`ROUTER_ID_I_SYSTEM_ROUTER:
				case(target_node)
					`NODE_ID_I_SNIM_I_EDGE_VIDEO_SYSTEM_VDMA_CTRL: routing_info = 7'b 0000001;
					`NODE_ID_I_SNIM_I_EDGE_VIDEO_SYSTEM_VIDEO_CTRL: routing_info = 7'b 0000010;
					`NODE_ID_I_SNIM_I_SYSTEM_SRAM_NO_NAME: routing_info = 7'b 0000100;
					`NODE_ID_I_SNIM_COMMON_PERI_GROUP_NO_NAME: routing_info = 7'b 0001000;
					`NODE_ID_I_SNIM_EXTERNAL_PERI_GROUP_NO_NAME: routing_info = 7'b 0010000;
					`NODE_ID_I_SNIM_PLATFORM_CONTROLLER_NO_NAME: routing_info = 7'b 0100000;
					`NODE_ID_DEFAULT_SLAVE: routing_info = 7'b 1000000;
				endcase
			`ROUTER_ID_I_USER_ROUTER:
				case(target_node)
					`NODE_ID_I_SNIM_EMAMBA_IP_SLAVE: routing_info = 12'b 000000000001;
					`NODE_ID_I_SNIM_INPUT_BRAM_SLAVE: routing_info = 12'b 000000000010;
					`NODE_ID_I_SNIM_WB_BRAM_SLAVE: routing_info = 12'b 000000000100;
					`NODE_ID_I_SNIM_OUTPUT_BRAM_SLAVE: routing_info = 12'b 000000001000;
					`NODE_ID_I_SNIM_I_SYSTEM_DDR_NO_NAME: routing_info = 12'b 000000010000;
					`NODE_ID_I_SNIM_I_EDGE_VIDEO_SYSTEM_VDMA_CTRL: routing_info = 12'b 000000100000;
					`NODE_ID_I_SNIM_I_EDGE_VIDEO_SYSTEM_VIDEO_CTRL: routing_info = 12'b 000000100000;
					`NODE_ID_I_SNIM_I_SYSTEM_SRAM_NO_NAME: routing_info = 12'b 000000100000;
					`NODE_ID_I_SNIM_COMMON_PERI_GROUP_NO_NAME: routing_info = 12'b 000000100000;
					`NODE_ID_I_SNIM_EXTERNAL_PERI_GROUP_NO_NAME: routing_info = 12'b 000000100000;
					`NODE_ID_I_SNIM_PLATFORM_CONTROLLER_NO_NAME: routing_info = 12'b 000000100000;
					`NODE_ID_DEFAULT_SLAVE: routing_info = 12'b 000000100000;
				endcase
		endcase
	`BACKWARD_NETWORK:
		case(ROUTER_ID)
			`ROUTER_ID_I_SYSTEM_ROUTER:
				case(target_node)
					`NODE_ID_I_MNIM_I_MAIN_CORE_INST: routing_info = 6'b 000001;
					`NODE_ID_I_MNIM_I_MAIN_CORE_DATA: routing_info = 6'b 000001;
					`NODE_ID_I_MNIM_I_EDGE_VIDEO_SYSTEM_VDMA: routing_info = 6'b 000001;
					`NODE_ID_I_MNIM_I_EDGE_VIDEO_SYSTEM_VIM: routing_info = 6'b 000001;
					`NODE_ID_I_MNIM_I_EDGE_VIDEO_SYSTEM_VOM: routing_info = 6'b 000001;
					`NODE_ID_I_MNIM_PLATFORM_CONTROLLER_MASTER: routing_info = 6'b 000001;
				endcase
			`ROUTER_ID_I_USER_ROUTER:
				case(target_node)
					`NODE_ID_I_MNIM_I_MAIN_CORE_INST: routing_info = 6'b 000001;
					`NODE_ID_I_MNIM_I_MAIN_CORE_DATA: routing_info = 6'b 000010;
					`NODE_ID_I_MNIM_I_EDGE_VIDEO_SYSTEM_VDMA: routing_info = 6'b 000100;
					`NODE_ID_I_MNIM_I_EDGE_VIDEO_SYSTEM_VIM: routing_info = 6'b 001000;
					`NODE_ID_I_MNIM_I_EDGE_VIDEO_SYSTEM_VOM: routing_info = 6'b 010000;
					`NODE_ID_I_MNIM_PLATFORM_CONTROLLER_MASTER: routing_info = 6'b 100000;
				endcase
		endcase
endcase